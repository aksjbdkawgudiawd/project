# Example names only; scripts do not automatically source this file.
# Inject secrets through your deployment environment or secret manager.
APP_ENV=demo
DATABASE_URL=sqlite:///.hoplite/marketplace.sqlite3

# Required outside demo. Never use example or shared credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
INVENTORY_ENCRYPTION_KEY=
ADMIN_ALLOWED_ORIGINS=

# Telegram is inactive without a token.
BOT_TOKEN=
BOT_INTERNAL_TOKEN=
BOT_API_URL=http://127.0.0.1:8000/api/bot
BOT_DEFAULT_LOCALE=ru
BOT_TEMPLATES_DIRECTORY=
BOT_REQUIRED_CHAT_ID=
REDIS_URL=

# Leave disabled until the client configures verified manual-transfer details.
MANUAL_PAYMENT_INSTRUCTIONS=
# Demo-only password access. Production uses audited admin grants for now.
WHOLESALE_PASSWORD_HASH=
